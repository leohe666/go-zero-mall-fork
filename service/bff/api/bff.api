syntax = "v1"

// =============================================================================
// BFF (Backend For Frontend) 服务：承载需要业务编排 / JWT 签发与校验的接口。
//
// 这些接口原本混在统一网关(gateway)里，方案 B 已把它们拆到独立进程：
//   - 网关 (8888) 只做纯 HTTP -> gRPC 透传（见 service/gateway/api/etc/gateway.yaml）
//   - 本服务 (8887) 负责 login / userinfo / aggregate 等聚合编排接口
// =============================================================================

type (
	// 订单详情（供聚合响应复用）
	OrderDetailResponse {
		Id     int64 `json:"id"`
		Uid    int64 `json:"uid"`
		Pid    int64 `json:"pid"`
		Amount int64 `json:"amount"`
		Status int64 `json:"status"`
	}
	// 商品详情（供聚合响应复用）
	ProductDetailResponse {
		Id     int64  `json:"id"`
		Name   string `json:"name"`
		Desc   string `json:"desc"`
		Stock  int64  `json:"stock"`
		Amount int64  `json:"amount"`
		Status int64  `json:"status"`
	}
	UserLoginRequest {
		Mobile   string `json:"mobile"`
		Password string `json:"password"`
	}
	UserLoginResponse {
		AccessToken  string `json:"accessToken"`
		AccessExpire int64  `json:"accessExpire"`
	}
	UserInfoResponse {
		Id     int64  `json:"id"`
		Name   string `json:"name"`
		Gender int64  `json:"gender"`
		Mobile string `json:"mobile"`
	}
	// 聚合查询：一次返回订单 + 用户 + 商品
	OrderAggregateRequest {
		Id int64 `json:"id"`
	}
	OrderAggregateResponse {
		Order   OrderDetailResponse   `json:"order"`
		User    UserInfoResponse      `json:"user"`
		Product ProductDetailResponse `json:"product"`
	}
)

// No Auth needed
service Bff {
	@handler UserLogin
	post /api/user/login (UserLoginRequest) returns (UserLoginResponse)
}

// Auth needed
@server (
	jwt: Auth
)
service Bff {
	@handler UserInfo
	post /api/user/userinfo returns (UserInfoResponse)

	@handler OrderAggregate
	post /api/order/aggregate (OrderAggregateRequest) returns (OrderAggregateResponse)
}
